
[image=0x20000000]

[virtual=armle,raw] .bootstrap = {
	startup-mb86h60 -vvvvvvv
	PATH=:/proc/boot:/sbin:/bin:/usr/sbin:/usr/bin LD_LIBRARY_PATH=:/proc/boot:/lib:/usr/lib:/lib/dll procnto-v6 -vvvvv
}

[+script] .script = {
	display_msg Welcome to QNX Neutrino 6.5.0-SP1 on the MB86H60

	PATH=:/proc/boot:/sbin:/bin:/usr/sbin:/usr/bin:/opt/bin
	LD_LIBRARY_PATH=:/proc/boot:/lib:/usr/lib:/lib/dll:/opt/lib

	procmgr_symlink ../../proc/boot/libc.so.3 /usr/lib/ldqnx.so.2

	slogger
	pipe

	#######################################################################
	## SERIAL driver
	##
	## Note: clock 24MHz, baud 115200, shift 2, IRQ33
	##       see devc
	#######################################################################
 	display_msg Starting UART0 driver...
	devc-serdebug -e -F -S -b115200 -c133000000 0xC2000000,8
	display_msg Waiting for device...
	waitfor /dev/ser1 4
	display_msg Reopening for device...
	reopen /dev/ser1  
	display_msg Serial opened...

    #######################################################################
    ## USB OTG Host Controller driver
    #######################################################################
    display_msg Starting USB OTG Host driver...
    io-usb -vvvvv -d mb86h60-mg ioport=0xc7000800,irq=21
    waitfor /dev/io-usb/io-usb 4
    display_msg USB device node available
    CACHE_NOP=1 devb-umass cam pnp
#    waitfor /dev/hd0 4
#    mount -t dos -o exe=all /dev/hd0t12 /mnt
#    mount -t ext2 /dev/hd0t131 /mnt
#    mount -t qnx6 /dev/hd0t131 /mnt
#    waitfor /mnt 4

	#######################################################################
	## These env variables are inherited by all the programs which follow
	#######################################################################
	SYSNAME=nto
	SHELL=/bin/sh
	TERM=qansi
	HOME=/
	PATH=:/proc/boot:/sbin:/bin:/usr/sbin:/usr/bin:/opt/bin
	LD_LIBRARY_PATH=:/proc/boot:/lib:/usr/lib:/lib/dll:/opt/lib
	# ls -l /dev
	[+session] sh &
}

[type=link] /usr/lib/ldqnx.so.2=/proc/boot/libc.so.3
[type=link] /bin/sh=/proc/boot/sh
[type=link] /dev/console=/dev/ser1
[type=link] /tmp=/dev/shmem

# Shared libraries
libc.so.3

libusbdi.so
libcam.so
io-blk.so
cam-disk.so
fs-ext2.so
fs-dos.so
#fs-nt.so
#fs-qnx6.so

[data=copy]

# Executables
[data=c]

devc-serdebug

devu-mb86h60-mg.so
io-usb
usb
devb-umass

###########################################################################
## general commands
###########################################################################

pipe
slogger
waitfor
sh
use
sloginfo
ls
shutdown
ldd
pidin
