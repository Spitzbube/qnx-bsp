<?xml version="1.0"?>
<module name="devnp-cpsw2g">
    <type>Element</type>
    <classification>Driver</classification>

        <description>
            <short>Driver for TI j721e cpsw2g controllers</short>
            <abstract>
                <![CDATA[The j721e cpsw2g ethernet driver.]]>
            </abstract>
        </description>

    <supports>
        <availability>
            <cpu isa="aarch64">
                <byteOrder>le</byteOrder>
            </cpu>
        </availability>
    </supports>

    <source available="false">
        <location type="">.</location>
    </source>

    <GroupOwner>net</GroupOwner>

    <contents>
        <package isInternal="true">
        <component id="driver" generated="true">
            <location basedir="{cpu}/dll{.:endian}"
                runtime="true">devnp-cpsw2g.so</location>
        </component>
        </package>
    </contents>

    <requires>
        <part build="true" location="lib/io-pkt/sys/lib/libnetdrvr"/>
    </requires>

</module>
