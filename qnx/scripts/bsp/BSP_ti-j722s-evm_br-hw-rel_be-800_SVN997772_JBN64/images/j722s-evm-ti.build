################################################################################################
##
## Build file for a QNX operating system
##
################################################################################################

[-optional]
[+keeplinked]
[image=0x80080000]
[virtual=aarch64le,raw +compress] boot = {
    ### <--- For ti - start
    #######################################################################
    # startup options:
    # [1] Carveout memory required for SPL boot (Added by TI).
    #  Carveout of 0x0007FFFF (512KB) at 0x80000000 to protect load address of arm trusted firmware.
    #
    # [2] Carveout memory for remote cores (Added by TI).
    #  Start addresses for carveouts are at 0x90000000 for low-mem carveouts, and at 0x880000000 for high-mem carveouts
    #  The first codec carevout of 0x10000000 (256MB) starting at address 0x90000000.
    #  The first remote core carevout 0x60000000 (1.5GB) is in the lower 2GB memory range starting at address 0xA0000000.
    #  The second remote core carevout 0x20000000 (512MB) is in the higher 14GB memory range starting at address 0x880000000.
    #  The second codec carveout of 0x60000000 (1536MB) is also in the higher 14GB memory range starting at 0x940000000.
    #  The third remote core carveout of 0x20000000 (512MB) is also in the higher 14GB memory range starting at 0x900000000.
    #######################################################################
    [+keeplinked] startup-j722s-evm -u arg -v -r0x80000000,0x0007FFFF,1 -r0x90000000,0x10000000,1 -r0xA0000000,0x60000000,1 -r0x880000000,0x20000000,1 -r0x940000000,0x60000000,1 -r0x900000000,0x20000000,1 -d
    #### For ti - end --->
    PATH=/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin:/usr/libexec
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll:/lib/dll/pci procnto-smp-instr -v -mr
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi
    ENV=/etc/profile

    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    ## Needed for ksh to run the echo command below
    pipe

    display_msg " "
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m) !"
    display_msg " "

    slogger2
    dumper
    mqueue
    random


    #######################################################################
    ## TI SCI / IPC Resource Managers
    #######################################################################
    #tisci-mgr
    #waitfor /dev/tisci 4
    #shmemallocator
    #waitfor /dev/shmemallocator 4
    #tiipc-mgr
    #waitfor /dev/tiipc 4
    #tiudma-mgr
    #waitfor /dev/tiudma 4



    ############################################################################################
    ## I2C driver
    ############################################################################################
    display_msg "Starting I2C driver ..."
    i2c-tda4 -p0x20000000 -i193 -d
    ### <--- For ti - start
    # TODO: Need to figure out how to share i2c1 controller between A53 and R5F
    # i2c-tda4 -p0x20010000 -i194 -d --u1
    # i2c-tda4 -p0x20020000 -i195 -d --u2
    ### For ti - end --->


    #######################################################################
    ## Configure the IO expanders
    #######################################################################
    /scripts/configure_i2c_io_expanders.sh


    #######################################################################
    ## UART drivers
    #######################################################################
    display_msg "start serial driver"
    devc-seromap -e -F 0x02800000,210
    reopen /dev/ser1



    ############################################################################################
    ## SD memory card / eMMC driver
    ############################################################################################
    display_msg Starting MMC/SD memory card driver... eMMC
    devb-sdmmc-am65x sdio addr=0x0fa10000,bw=~4:8,irq=165,timing=~hs400,emmc,bs=sscfg=0x8000 disk name=emmc

    display_msg Starting MMC/SD memory card driver... SD
    devb-sdmmc-am65x sdio addr=0x0fa00000,irq=115,bs=sscfg=0x8000:ldo=0x600000^70:trm-icp=2 cam pnp disk name=sd



    #######################################################################
    ## OSPI NOR flash driver without DMSS support
    #######################################################################
    # display_msg "Starting Flash driver..."
    # devf-j7-ospi -s soc=rclk=200000000:base=0xfc40000:clk=25000000:rdelay=4
    #######################################################################
    ## OSPI NOR flash driver with DMSS support
    ## need tisci-mgr and tiudma-mgr to access TI DMSS library
    ## need "-I" option to access DMSS registers
    ## need direct and PHY mode for DMA transfer
    #######################################################################
    # display_msg "Starting Flash driver..."
    # devf-j7-ospi -I -s soc=rclk=200000000:base=0xfc40000:clk=25000000:rdelay=4:poffset=0x3fc0000:phy=1:dma=1


    #######################################################################
    ## XHCI on both USB-C and A ports
    #######################################################################
    display_msg Starting XHCI driver on USB3SS0 and USB3SS1
    io-usb-otg -d dwc3-xhci ioport=0x31000000,irq=220 -d cdns3-xhci ioport=0x31210000,irq=258,iosize=65536
    waitfor /dev/usb/io-usb-otg 4


    ############################################################################################
    ## Storage service
    ############################################################################################
    # Required for dhcpcd
    /proc/boot/.storage-server.sh


    #######################################################################
    ## Using CPSW driver that requires PSDK support
    #######################################################################
    # display_msg "Starting networking ..."
    # io-sock -m phy   -m usb -d axe -d axge -d cdce -d smsc  -mfdt -dcpsw-j722s


    ############################################################################################
    ## Network driver
    ############################################################################################
    # display_msg "Starting networking ..."
    # io-sock  -m phy   -m usb -d axe -d axge -d cdce -d smsc
    # TI builds do not enable cpsw by default. io-sock driver for cpsw is delivered as part of
    # QNX BSP/ io-sock package

    ############################################################################################
    ## DHCP client
    ############################################################################################
    # display_msg "Starting DHCP client ..."
    # dhcpcd -bqq

    ############################################################################################
    ## SSH daemon
    ############################################################################################
    # /proc/boot/.ssh-server.sh

    ############################################################################################
    ## REMOTE_DEBUG: gdb or Momentics
    ##  - refer to the help documentation for the gdb, qconn and the IDE
    ##    for more information on remote debugging
    ##  - the commands shown require that NETWORK is enabled too
    ############################################################################################
    # display_msg "Starting devc-pty manager ..."
    # devc-pty

    # display_msg "Starting qconn daemon ..."
    # qconn


    ############################################################################################
    ## Customize startup components
    ############################################################################################
    ksh /proc/boot/customize_startup.sh



    ############################################################################################
    ## Start the main shell
    ############################################################################################
    reopen /dev/ser1
    # display_msg "Starting shell ..."
    # [+session] ksh &
    ### <--- For ti - start
    [+session] ksh /proc/boot/.console_ti.sh &
    #### For ti - end --->
}


[uid=0 gid=0]

[type=link] /bin/sh=/bin/ksh
[type=link] /tmp=/dev/shmem
[type=link] /dev/console=/dev/ser1
[type=link] /var/log=/tmp
[type=link] /usr/tmp=/tmp


################################################################################################
## Serial drivers
################################################################################################
/sbin/devc-seromap=devc-seromap


################################################################################################
## NOR flash driver files
################################################################################################
/sbin/devf-ram=devf-ram
/sbin/devf-j7-ospi=devf-j7-ospi

/usr/bin/flashctl=flashctl


################################################################################################
## Block drivers
################################################################################################
/sbin/devb-ram=devb-ram
/sbin/devb-sdmmc-am65x=devb-sdmmc-am65x

################################################################################################
## Block driver support libraries
################################################################################################
/lib/libcam.so=libcam.so

/lib/dll/io-blk.so=io-blk.so
/lib/dll/cam-disk.so=cam-disk.so
/lib/dll/cam-cdrom.so=cam-cdrom.so
/lib/dll/fs-qnx6.so=fs-qnx6.so
/lib/dll/fs-dos.so=fs-dos.so


