VERSION_MAJOR=0
VERSION_MINOR=1

ROOT_DIR := $(notdir $(CURDIR))
ifndef QCONFIG
QCONFIG=qconfig.mk
endif
include $(QCONFIG)
unexport ROOT_DIR

.PHONY: all install clean

# Expands to a single newline character
define NEWLINE

endef

SUFFIXES := .mk
EXECUTABLE= k3conf

all: $(EXECUTABLE)
	@echo done

subdirs:=$(subst /Makefile,,$(wildcard */[Mm]akefile))

clean:
	$(foreach dir,$(subdirs), $(MAKE) -C$(dir) clean $(NEWLINE))
	-$(RM_HOST) -r builddate.c
	-$(RM_HOST) -r version.c

$(EXECUTABLE): 
	@echo 'char *builddate="'`date`'";' > builddate.c
	@echo 'char *k3conf_version="'`git describe --tag||echo "$(VERSION_MAJOR).$(VERSION_MINOR)-nogit"`'";' > version.c
	$(MAKE) -Cqnx K3CONF_REPO=`pwd` $(INSTALL_CMD)


